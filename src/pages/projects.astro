---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';

const projects = [
  {
    title: 'EcoPulse',
    description: 'An end-to-end batch data pipeline designed to ingest, process, and analyze key economic indicators. Built using a cloud-native architecture that handles the transition from raw data to actionable business intelligence. Streamlines the monitoring of macroeconomic trends through automated data flow.',
    techStack: ['Python', 'Terraform', 'GCS', 'BigQuery', 'Kestra', 'Docker'],
    githubUrl: 'https://github.com/dehaoterryzhang/EcoPulse',
  },
  {
    title: 'ToSDR-RAG',
    description: 'A sophisticated Retrieval-Augmented Generation (RAG) system based on the "Terms of Service; Didn\'t Read" (ToSDR) dataset. Utilizes vector embeddings and semantic search to allow users to query complex legal documents in natural language. Increases transparency in digital contracts by providing instant, context-aware summaries of user agreements.',
    techStack: ['Python', 'LLMs', 'RAG', 'Vector DB', 'NLP', 'LangChain'],
    githubUrl: 'https://github.com/dehaoterryzhang/ToSDR-RAG',
  },
];
---

<BaseLayout title="Projects — Dehao Zhang">
  <Header />
  
  <main class="min-h-screen">
    <!-- Hero Section -->
    <section class="relative py-20 overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-primary-50 via-white to-white dark:from-primary-950/20 dark:via-dark-bg dark:to-dark-bg -z-10"></div>
      
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center">
          <h1 class="text-4xl sm:text-5xl font-bold text-gray-900 dark:text-white mb-6">
            My <span class="bg-gradient-to-r from-primary-600 to-primary-400 bg-clip-text text-transparent">Projects</span>
          </h1>
          <p class="text-xl text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
            Building end-to-end data pipelines and implementing advanced AI architectures to solve real-world information challenges.
          </p>
        </div>
      </div>
    </section>

    <!-- Projects Grid -->
    <section class="py-12 pb-20">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid md:grid-cols-2 gap-8">
          {projects.map((project) => (
            <ProjectCard {...project} />
          ))}
        </div>
      </div>
    </section>

    <!-- GitHub CTA -->
    <section class="py-16 bg-gray-50 dark:bg-dark-card/50">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">
          Want to see more?
        </h2>
        <p class="text-gray-600 dark:text-gray-400 mb-6">
          Check out my GitHub profile for more projects, contributions, and experiments.
        </p>
        <a 
          href="https://github.com/dehaoterryzhang"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center space-x-2 px-6 py-3 bg-gray-900 dark:bg-white dark:text-gray-900 text-white font-medium rounded-lg hover:bg-gray-800 dark:hover:bg-gray-100 transition-colors duration-200"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
          </svg>
          <span>View GitHub Profile</span>
        </a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
