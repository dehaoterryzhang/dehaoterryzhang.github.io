---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SocialIcons from '../components/SocialIcons.astro';

const experience = [
  {
    company: 'Microsoft',
    location: 'Redmond, WA',
    roles: [
      { title: 'Senior Data Scientist', period: 'Mar 2025 – Present' },
      { title: 'Data Scientist', period: 'Jul 2020 – Mar 2025' },
      { title: 'Business Intelligence Intern', period: 'May 2019 – Aug 2019' },
    ],
  },
  {
    company: 'University of Michigan — Rackham Graduate School',
    location: 'Ann Arbor, MI',
    roles: [
      { title: 'Graduate Student Instructor', period: 'Sep 2018 – Apr 2020' },
    ],
  },
  {
    company: 'Wayne County Airport Authority',
    location: 'Detroit, MI',
    roles: [
      { title: 'Operations Consultant', period: 'Jan 2018 – Apr 2018' },
    ],
  },
  {
    company: 'Cummins Inc.',
    location: 'Columbus, IN',
    roles: [
      { title: 'Quality Engineer Co-op', period: 'Jan 2017 – Jul 2017' },
    ],
  },
];

const education = [
  {
    school: 'University of Michigan — Rackham Graduate School',
    degree: "Master's Degree, Industrial & Operations Engineering",
    period: '2018 – 2020',
    extras: ['Graduate Data Science Certificate Program'],
  },
  {
    school: 'University of Michigan',
    degree: 'B.S., Industrial & Operations Engineering',
    period: '2014 – 2018',
  },
];

const certifications = [
  'Microsoft Azure Data Scientist Associate',
  'Microsoft Azure AI Engineer Associate',
  'Data Engineering Zoomcamp',
  'LLM Zoomcamp',
  'Six Sigma Green Belt',
  'Data Scientist with Python',
];

const skills = {
  core: ['Data Science', 'Artificial Intelligence', 'Machine Learning', 'Retrieval-Augmented Generation (RAG)'],
  technical: ['Python', 'R', 'SQL', 'Azure', 'Power BI', 'Spark', 'Data Engineering', 'Statistics', 'Analytics'],
  methodologies: ['Six Sigma', 'Process Optimization', 'Automation', 'Predictive Modeling'],
  soft: ['Cross-functional Communication', 'Mentorship', 'Analytical Storytelling'],
};
---

<BaseLayout title="About — Dehao Zhang">
  <Header />
  
  <main class="min-h-screen">
    <!-- Hero Section -->
    <section class="relative py-20 overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-primary-50 via-white to-white dark:from-primary-950/20 dark:via-dark-bg dark:to-dark-bg -z-10"></div>
      
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col lg:flex-row items-center gap-12">
          <!-- Profile Image -->
          <div class="flex-shrink-0">
            <div class="relative">
              <div class="w-48 h-48 sm:w-56 sm:h-56 rounded-full overflow-hidden border-4 border-white dark:border-dark-card shadow-xl">
                <img 
                  src="/ProfilePicture_1_1.jpg" 
                  alt="Dehao Zhang"
                  class="w-full h-full object-cover"                />
              </div>
            </div>
          </div>

          <!-- Bio -->
          <div class="flex-1 text-center lg:text-left">
            <h1 class="text-4xl sm:text-5xl font-bold text-gray-900 dark:text-white mb-4">
              About <span class="bg-gradient-to-r from-primary-600 to-primary-400 bg-clip-text text-transparent">Me</span>
            </h1>
            
            <p class="text-xl text-gray-600 dark:text-gray-400 mb-6">
              I'm a <strong class="text-gray-900 dark:text-white">Senior Data Scientist at Microsoft</strong> passionate about optimizing business efficiency and enhancing decision-making through the power of data science and AI.
            </p>
            
            <p class="text-gray-600 dark:text-gray-400 mb-6">
              With a background in <strong>industrial engineering</strong> and <strong>data science</strong>, I bring 5+ years of experience building intelligent solutions, conducting data analytics, and leading AI and automation projects. My work focuses on creating business value by leveraging advanced technologies to drive strategic insights and operational improvements.
            </p>

            <div class="flex items-center justify-center lg:justify-start gap-4">
              <SocialIcons size="lg" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Experience Section -->
    <section class="py-16 bg-gray-50 dark:bg-dark-card/50">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-8 text-center">
          💼 Experience
        </h2>
        
        <div class="space-y-8">
          {experience.map((job) => (
            <div class="bg-white dark:bg-dark-card rounded-xl border border-gray-200 dark:border-dark-border p-6">
              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-4">
                <h3 class="text-xl font-semibold text-gray-900 dark:text-white">{job.company}</h3>
                <span class="text-sm text-gray-500 dark:text-gray-500">{job.location}</span>
              </div>
              <div class="space-y-3">
                {job.roles.map((role) => (
                  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pl-4 border-l-2 border-primary-500">
                    <span class="font-medium text-gray-700 dark:text-gray-300">{role.title}</span>
                    <span class="text-sm text-gray-500 dark:text-gray-500">{role.period}</span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Education Section -->
    <section class="py-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-8 text-center">
          🎓 Education
        </h2>
        
        <div class="grid md:grid-cols-2 gap-6">
          {education.map((edu) => (
            <div class="bg-white dark:bg-dark-card rounded-xl border border-gray-200 dark:border-dark-border p-6">
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-1">{edu.school}</h3>
              <p class="text-gray-600 dark:text-gray-400 mb-2">{edu.degree}</p>
              <p class="text-sm text-gray-500 dark:text-gray-500 mb-2">{edu.period}</p>
              {edu.extras && (
                <ul class="space-y-1">
                  {edu.extras.map((extra) => (
                    <li class="text-sm text-primary-600 dark:text-primary-400">+ {extra}</li>
                  ))}
                </ul>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Skills Section -->
    <section class="py-16 bg-gray-50 dark:bg-dark-card/50">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-8 text-center">
          🧠 Skills & Expertise
        </h2>
        
        <div class="grid md:grid-cols-2 gap-8">
          <div>
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Core Areas</h3>
            <div class="flex flex-wrap gap-2">
              {skills.core.map((skill) => (
                <span class="px-3 py-1.5 bg-primary-100 dark:bg-primary-900/30 text-primary-700 dark:text-primary-300 rounded-lg text-sm font-medium">
                  {skill}
                </span>
              ))}
            </div>
          </div>
          
          <div>
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Technical Stack</h3>
            <div class="flex flex-wrap gap-2">
              {skills.technical.map((skill) => (
                <span class="px-3 py-1.5 bg-gray-100 dark:bg-dark-border text-gray-700 dark:text-gray-300 rounded-lg text-sm">
                  {skill}
                </span>
              ))}
            </div>
          </div>
          
          <div>
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Methodologies</h3>
            <div class="flex flex-wrap gap-2">
              {skills.methodologies.map((skill) => (
                <span class="px-3 py-1.5 bg-gray-100 dark:bg-dark-border text-gray-700 dark:text-gray-300 rounded-lg text-sm">
                  {skill}
                </span>
              ))}
            </div>
          </div>
          
          <div>
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Soft Skills</h3>
            <div class="flex flex-wrap gap-2">
              {skills.soft.map((skill) => (
                <span class="px-3 py-1.5 bg-gray-100 dark:bg-dark-border text-gray-700 dark:text-gray-300 rounded-lg text-sm">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Certifications Section -->
    <section class="py-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-8 text-center">
          📜 Certifications
        </h2>
        
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {certifications.map((cert) => (
            <div class="flex items-center space-x-3 p-4 bg-white dark:bg-dark-card rounded-xl border border-gray-200 dark:border-dark-border">
              <svg class="w-6 h-6 text-green-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
              </svg>
              <span class="text-gray-700 dark:text-gray-300 text-sm">{cert}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Publication Section -->
    <section class="py-16 bg-gray-50 dark:bg-dark-card/50">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-8 text-center">
          🧩 Publications
        </h2>
        
        <div class="bg-white dark:bg-dark-card rounded-xl border border-gray-200 dark:border-dark-border p-6 max-w-2xl mx-auto hover:shadow-lg transition-shadow duration-300">
          <a 
            href="https://www.pnas.org/doi/10.1073/pnas.2310431120"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-start space-x-4 group"
          >
            <svg class="w-8 h-8 text-primary-500 flex-shrink-0 mt-1 group-hover:text-primary-600 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
            <div>
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
                Navigating the New Normal: Examining Coattendance in a Hybrid Work Environment
                <svg class="w-4 h-4 inline-block ml-1 opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </h3>
              <p class="text-gray-600 dark:text-gray-400 text-sm mb-2">
                Research on hybrid work patterns and collaboration in modern workplaces.
              </p>
              <span class="text-xs text-primary-600 dark:text-primary-400 font-medium">Published in PNAS</span>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- Connect CTA -->
    <section class="py-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">
          Let's Connect
        </h2>
        <p class="text-gray-600 dark:text-gray-400 mb-6">
          I'm always interested in discussing data science, AI, and opportunities to collaborate.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a 
            href="https://www.linkedin.com/in/dehao-terry-zhang/"
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3 bg-[#0A66C2] hover:bg-[#004182] text-white font-medium rounded-lg transition-colors duration-200 inline-flex items-center space-x-2"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
            <span>Connect on LinkedIn</span>
          </a>
          <a 
            href="https://github.com/dehaoterryzhang"
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3 border border-gray-300 dark:border-gray-600 hover:border-primary-500 dark:hover:border-primary-500 text-gray-700 dark:text-gray-300 font-medium rounded-lg transition-colors duration-200 inline-flex items-center space-x-2"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
            </svg>
            <span>View GitHub</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
