---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BlogCard from '../components/BlogCard.astro';

const technicalBlogPosts = [
  {
    title: 'Building EcoPulse: A Scalable Batch Pipeline for Economic Data',
    description: 'A deep dive into building a scalable batch pipeline for economic data, focusing on end-to-end automation with cloud-native tools.',
    url: 'https://medium.com/@terryz_',
    tags: ['Data Engineering', 'Cloud', 'Automation'],
  },
  {
    title: 'Mastering Kestra: Workflow Orchestration for Modern Data Pipelines',
    description: 'A comprehensive guide on workflow orchestration, from Postgres ETL to managing GCS and BigQuery pipelines.',
    url: 'https://medium.com/@terryz_',
    tags: ['Data Engineering Zoomcamp', 'Orchestration', 'Kestra'],
  },
  {
    title: 'Terraform Foundations: Infrastructure as Code for Data Engineers',
    description: 'Practical guides on Infrastructure as Code (IaC) for managing cloud resources reliably and reproducibly.',
    url: 'https://medium.com/@terryz_',
    tags: ['Data Engineering Zoomcamp', 'Terraform', 'IaC'],
  },
  {
    title: 'Spark Internals: Why Spark Outperforms Hadoop',
    description: 'Analysis of cluster architecture and why Spark outperforms Hadoop for modern big data workloads.',
    url: 'https://medium.com/@terryz_',
    tags: ['Data Engineering Zoomcamp', 'Spark', 'Big Data'],
  },
  {
    title: 'Running Spark in the Cloud: GCS and Cloud Jobs',
    description: 'Step-by-step guides on connecting Spark to Google Cloud Storage (GCS) and submitting cloud jobs.',
    url: 'https://medium.com/@terryz_',
    tags: ['Data Engineering Zoomcamp', 'Spark', 'GCP'],
  },
  {
    title: 'Analytics Engineering with dbt: From Models to Production',
    description: 'Comprehensive guides on building dbt models, testing, and deploying documentation in production environments.',
    url: 'https://medium.com/@terryz_',
    tags: ['Data Engineering Zoomcamp', 'dbt', 'Analytics'],
  },
  {
    title: 'BigQuery ML: Machine Learning in SQL',
    description: 'Implementing machine learning workflows directly within SQL-based queries for faster iteration and deployment.',
    url: 'https://medium.com/@terryz_',
    tags: ['Data Engineering Zoomcamp', 'BigQuery', 'ML'],
  },
  {
    title: 'Data Warehousing Deep Dive: BigQuery Best Practices',
    description: 'Deep dives into BigQuery concepts, including external vs. native tables and partitioning strategies.',
    url: 'https://medium.com/@terryz_',
    tags: ['Data Engineering Zoomcamp', 'BigQuery', 'Data Warehouse'],
  },
  {
    title: 'The "dlt" Workshop: Simplifying API Data Extraction',
    description: 'Exploring data ingestion and normalization with dlt to simplify API data extraction workflows.',
    url: 'https://medium.com/@terryz_',
    tags: ['Data Engineering Zoomcamp', 'dlt', 'Data Ingestion'],
  },
];

const reflectionsPosts = [
  {
    title: 'Learning to Learn: Three "Shortcuts" to Shift from Passive Consumption to Active Learning',
    description: 'What I learned when I stopped equating finishing lecture videos with understanding ideas — three key lessons to become an output-first learner.',
    url: 'https://dehaozhang.substack.com/p/learning-to-learn-three-shortcuts',
    tags: ['Learning', 'Personal Growth', 'Productivity'],
  },
  {
    title: 'The 6-Skill Moat: How to Remain Indispensable',
    description: 'Exploring the essential skills that create a lasting competitive advantage in your career and make you indispensable.',
    url: 'https://dehaozhang.substack.com/p/the-6-skill-moat-how-to-remain-indispensable',
    tags: ['Career', 'Skills', 'Personal Growth'],
  },
  {
    title: "Charlie Munger's Latticework: 5 Fundamental Mental Models",
    description: 'Exploring Charlie Munger\'s approach to decision-making through fundamental mental models from his latticework of knowledge.',
    url: 'https://dehaozhang.substack.com/p/charlie-mungers-latticework-5-fundamental',
    tags: ['Books', 'Mental Models', 'Investing'],
  },
];
---

<BaseLayout title="Blog — Dehao Zhang">
  <Header />
  
  <main class="min-h-screen">
    <!-- Hero Section -->
    <section class="relative py-20 overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-primary-50 via-white to-white dark:from-primary-950/20 dark:via-dark-bg dark:to-dark-bg -z-10"></div>
      
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center">
          <h1 class="text-4xl sm:text-5xl font-bold text-gray-900 dark:text-white mb-6">
            Learning Notes & <span class="bg-gradient-to-r from-primary-600 to-primary-400 bg-clip-text text-transparent">Reflections</span>
          </h1>
          <p class="text-xl text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
            Documenting my learning journey — from technical deep dives to life lessons and personal reflections.
          </p>
        </div>
      </div>
    </section>

    <!-- Technical Blog Section (Collapsible) -->
    <section id="technical" class="py-12 scroll-mt-20">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <details class="group" open>
          <summary class="flex items-center justify-between cursor-pointer list-none p-6 bg-white dark:bg-dark-card rounded-xl border border-gray-200 dark:border-dark-border hover:shadow-lg transition-all duration-300">
            <div class="flex items-center space-x-4">
              <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-primary-500 to-primary-700 flex items-center justify-center">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                </svg>
              </div>
              <div class="text-left">
                <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Technical Blog</h2>
                <p class="text-gray-500 dark:text-gray-400 text-sm mt-1">
                  Data engineering, AI, and cloud technologies — published on 
                  <a href="https://medium.com/@terryz_" target="_blank" rel="noopener noreferrer" class="text-primary-600 dark:text-primary-400 hover:underline">Medium</a>
                </p>
              </div>
            </div>
            <svg class="w-6 h-6 text-gray-500 transform group-open:rotate-180 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          
          <div class="mt-6 grid md:grid-cols-2 lg:grid-cols-3 gap-6 animate-fade-in">
            {technicalBlogPosts.map((post) => (
              <BlogCard {...post} />
            ))}
          </div>
          
          <div class="mt-8 text-center">
            <a 
              href="https://medium.com/@terryz_"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center space-x-2 px-6 py-3 bg-gray-900 dark:bg-white dark:text-gray-900 text-white font-medium rounded-lg hover:bg-gray-800 dark:hover:bg-gray-100 transition-colors duration-200"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"/>
              </svg>
              <span>Follow on Medium</span>
            </a>
          </div>
        </details>
      </div>
    </section>

    <!-- Reflections Section (Collapsible) -->
    <section id="reflections" class="py-12 pb-20 scroll-mt-20">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <details class="group">
          <summary class="flex items-center justify-between cursor-pointer list-none p-6 bg-white dark:bg-dark-card rounded-xl border border-gray-200 dark:border-dark-border hover:shadow-lg transition-all duration-300">
            <div class="flex items-center space-x-4">
              <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-amber-500 to-orange-600 flex items-center justify-center">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                </svg>
              </div>
              <div class="text-left">
                <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Reflections</h2>
                <p class="text-gray-500 dark:text-gray-400 text-sm mt-1">
                  Life lessons, personal growth, and insights from books — published on 
                  <a href="https://dehaozhang.substack.com/" target="_blank" rel="noopener noreferrer" class="text-primary-600 dark:text-primary-400 hover:underline">Substack</a>
                </p>
              </div>
            </div>
            <svg class="w-6 h-6 text-gray-500 transform group-open:rotate-180 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          
          <div class="mt-6 grid md:grid-cols-2 lg:grid-cols-3 gap-6 animate-fade-in">
            {reflectionsPosts.map((post) => (
              <BlogCard {...post} />
            ))}
          </div>
          
          <div class="mt-8 text-center">
            <a 
              href="https://dehaozhang.substack.com/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center space-x-2 px-6 py-3 bg-[#FF6719] text-white font-medium rounded-lg hover:bg-[#e55a14] transition-colors duration-200"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z"/>
              </svg>
              <span>Follow on Substack</span>
            </a>
          </div>
        </details>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
