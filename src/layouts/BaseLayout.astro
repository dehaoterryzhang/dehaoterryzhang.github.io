---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Dehao Zhang — Data Scientist & AI Builder",
  description = "Data Scientist specializing in Applied AI, Machine Learning, and Data Engineering. Building intelligent solutions at Microsoft."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Dehao Zhang" />
    
    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Dehao Zhang Portfolio" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Google Fonts - Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    
    <title>{title}</title>
    
    <!-- Theme Script (prevents flash) -->
    <script is:inline>
      const getThemePreference = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };
      const isDark = getThemePreference() === 'dark';
      document.documentElement.classList[isDark ? 'add' : 'remove']('dark');
    </script>
  </head>
  <body class="bg-white dark:bg-dark-bg text-gray-900 dark:text-gray-100 font-sans antialiased transition-colors duration-300">
    <slot />
    
    <!-- View Counter Script -->
    <script is:inline>
      // Simple view counter using localStorage (for demo purposes)
      // In production, you'd use a backend service or analytics
      const viewKey = 'portfolio_views';
      let views = parseInt(localStorage.getItem(viewKey) || '0');
      views++;
      localStorage.setItem(viewKey, views.toString());
      
      const counterEl = document.getElementById('view-counter');
      if (counterEl) {
        counterEl.textContent = views.toLocaleString();
      }
    </script>
  </body>
</html>
