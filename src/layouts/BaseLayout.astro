---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Dehao Zhang — Data Scientist & AI Builder",
  description = "Data Scientist specializing in Applied AI, Machine Learning, and Data Engineering. Building intelligent solutions at Microsoft."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Dehao Zhang" />
    
    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Dehao Zhang Portfolio" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Google Fonts - Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    
    <title>{title}</title>
    
    <!-- Theme Script (prevents flash) -->
    <script is:inline>
      const getThemePreference = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };
      const isDark = getThemePreference() === 'dark';
      document.documentElement.classList[isDark ? 'add' : 'remove']('dark');
    </script>
  </head>
  <body class="bg-white dark:bg-dark-bg text-gray-900 dark:text-gray-100 font-sans antialiased transition-colors duration-300">
    <slot />
    
    <!-- View Counter Script -->
    <script is:inline>
      // Cumulative view counter using CountAPI (free service)
      // This tracks views across ALL visitors and devices
      async function updateViewCount() {
        const counterEl = document.getElementById('view-counter');
        if (!counterEl) return;
        
        try {
          // Use CountAPI to track cumulative views
          // Namespace: dehaozhang, Key: portfolio-views
          const response = await fetch('https://api.countapi.xyz/hit/dehaozhang.github.io/portfolio-views');
          const data = await response.json();
          
          if (data && data.value) {
            counterEl.textContent = data.value.toLocaleString();
          }
        } catch (error) {
          // Fallback: try alternative service
          try {
            // Alternative: hits.seeyoufarm.com badge API
            const img = new Image();
            img.src = 'https://hits.seeyoufarm.com/api/count/incr/badge.svg?url=https%3A%2F%2Fdehaoterryzhang.github.io&count_bg=%233B82F6&title_bg=%23555555&icon=&icon_color=%23E7E7E7&title=views&edge_flat=true';
            counterEl.textContent = '—';
          } catch {
            counterEl.textContent = '—';
          }
        }
      }
      
      updateViewCount();
    </script>
  </body>
</html>
