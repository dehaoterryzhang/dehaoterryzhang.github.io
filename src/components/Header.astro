---
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Projects' },
  { href: '/about', label: 'About' },
];

const blogSubItems = [
  { href: '/blog#technical', label: 'Technical Blog', icon: '💻' },
  { href: '/blog#reading', label: 'Reading Blog', icon: '📚' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 backdrop-blur-xl bg-white/70 dark:bg-dark-bg/70 border-b border-gray-200/50 dark:border-dark-border/50">
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center space-x-2 group">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-primary-500 to-primary-700 flex items-center justify-center shadow-lg shadow-primary-500/25 group-hover:shadow-primary-500/40 transition-shadow duration-300">
          <span class="text-white font-bold text-sm">DZ</span>
        </div>
        <span class="hidden sm:inline text-gray-700 dark:text-gray-300 font-semibold group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
          Dehao Zhang
        </span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center space-x-1">
        {navItems.map((item) => (
          <a 
            href={item.href}
            class={`relative px-4 py-2 rounded-lg text-sm font-medium transition-all duration-300 
              ${currentPath === item.href 
                ? 'text-primary-600 dark:text-primary-400 bg-primary-50 dark:bg-primary-900/20' 
                : 'text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-dark-card/50'
              }
            `}
          >
            {item.label}
          </a>
        ))}
        
        <!-- Blog with Dropdown -->
        <div class="relative group">
          <a 
            href="/blog"
            class={`relative px-4 py-2 rounded-lg text-sm font-medium transition-all duration-300 flex items-center gap-1
              ${currentPath === '/blog' || currentPath.startsWith('/blog')
                ? 'text-primary-600 dark:text-primary-400 bg-primary-50 dark:bg-primary-900/20' 
                : 'text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-dark-card/50'
              }
            `}
          >
            Blog
            <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
          
          <!-- Dropdown Menu -->
          <div class="absolute top-full left-0 mt-1 w-48 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform origin-top scale-95 group-hover:scale-100">
            <div class="py-2 bg-white/95 dark:bg-dark-card/95 backdrop-blur-xl rounded-xl border border-gray-200/50 dark:border-dark-border/50 shadow-xl shadow-gray-200/50 dark:shadow-black/30">
              {blogSubItems.map((subItem) => (
                <a 
                  href={subItem.href}
                  class="flex items-center gap-3 px-4 py-2.5 text-sm text-gray-600 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400 hover:bg-primary-50 dark:hover:bg-primary-900/20 transition-colors"
                >
                  <span>{subItem.icon}</span>
                  <span>{subItem.label}</span>
                </a>
              ))}
            </div>
          </div>
        </div>
        
        <!-- Theme Toggle -->
        <button 
          id="theme-toggle"
          class="ml-2 p-2.5 rounded-xl bg-gray-100/80 dark:bg-dark-card/80 hover:bg-gray-200 dark:hover:bg-gray-700 transition-all duration-300 hover:scale-105"
          aria-label="Toggle dark mode"
        >
          <!-- Sun Icon -->
          <svg class="w-5 h-5 hidden dark:block text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" clip-rule="evenodd" />
          </svg>
          <!-- Moon Icon -->
          <svg class="w-5 h-5 block dark:hidden text-gray-700" fill="currentColor" viewBox="0 0 20 20">
            <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z" />
          </svg>
        </button>
      </div>

      <!-- Mobile Menu Button -->
      <div class="flex md:hidden items-center space-x-2">
        <button 
          id="theme-toggle-mobile"
          class="p-2 rounded-lg bg-gray-100 dark:bg-dark-card"
          aria-label="Toggle dark mode"
        >
          <svg class="w-5 h-5 hidden dark:block text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" clip-rule="evenodd" />
          </svg>
          <svg class="w-5 h-5 block dark:hidden text-gray-700" fill="currentColor" viewBox="0 0 20 20">
            <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z" />
          </svg>
        </button>
        
        <button 
          id="mobile-menu-btn"
          class="p-2 rounded-lg bg-gray-100 dark:bg-dark-card"
          aria-label="Open menu"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation -->
    <div id="mobile-menu" class="hidden md:hidden pb-4">
      <div class="flex flex-col space-y-2">
        {navItems.map((item) => (
          <a 
            href={item.href}
            class={`px-4 py-2 rounded-lg transition-colors duration-200
              ${currentPath === item.href 
                ? 'bg-primary-100 dark:bg-primary-900/30 text-primary-600 dark:text-primary-400' 
                : 'text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-dark-card'
              }
            `}
          >
            {item.label}
          </a>
        ))}
        
        <!-- Blog Section with Sub-items -->
        <div class="space-y-1">
          <a 
            href="/blog"
            class={`px-4 py-2 rounded-lg transition-colors duration-200 block
              ${currentPath === '/blog' || currentPath.startsWith('/blog')
                ? 'bg-primary-100 dark:bg-primary-900/30 text-primary-600 dark:text-primary-400' 
                : 'text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-dark-card'
              }
            `}
          >
            Blog
          </a>
          <div class="pl-4 space-y-1">
            {blogSubItems.map((subItem) => (
              <a 
                href={subItem.href}
                class="flex items-center gap-2 px-4 py-1.5 rounded-lg text-sm text-gray-500 dark:text-gray-500 hover:text-primary-600 dark:hover:text-primary-400 hover:bg-gray-50 dark:hover:bg-dark-card/50 transition-colors"
              >
                <span>{subItem.icon}</span>
                <span>{subItem.label}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </nav>
</header>

<script>
  // Theme toggle functionality
  function setupThemeToggle() {
    const toggleButtons = document.querySelectorAll('#theme-toggle, #theme-toggle-mobile');
    
    toggleButtons.forEach(btn => {
      btn?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });
    });
  }

  // Mobile menu toggle
  function setupMobileMenu() {
    const menuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    
    menuBtn?.addEventListener('click', () => {
      mobileMenu?.classList.toggle('hidden');
    });
  }

  setupThemeToggle();
  setupMobileMenu();

  // Re-run on page navigation (for View Transitions)
  document.addEventListener('astro:after-swap', () => {
    setupThemeToggle();
    setupMobileMenu();
  });
</script>
