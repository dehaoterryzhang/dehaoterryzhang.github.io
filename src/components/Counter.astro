---
// Counter.astro - Client-side view counter component
---

<span id="view-counter" class="font-semibold">0</span>

<script>
  // This script runs on the client side in the browser
  async function updateViewCount() {
    const counterEl = document.getElementById('view-counter');
    if (!counterEl) return;
    
    // Show loading state
    counterEl.textContent = '...';
    
    try {
      // Use CountAPI to track cumulative views
      const response = await fetch('https://api.countapi.dev/hit/dehaozhang.github.io/portfolio-views');
      
      if (!response.ok) {
        throw new Error('CountAPI failed');
      }
      
      const data = await response.json();
      
      if (data && data.value) {
        counterEl.textContent = data.value.toLocaleString();
      } else {
        throw new Error('No value returned');
      }
    } catch (error) {
      console.log('CountAPI error:', error);
      // Fallback to localStorage count (at least shows something)
      const localCount = parseInt(localStorage.getItem('fallback_views') || '0') + 1;
      localStorage.setItem('fallback_views', localCount.toString());
      counterEl.textContent = localCount.toLocaleString();
    }
  }
  
  // Run when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', updateViewCount);
  } else {
    updateViewCount();
  }
</script>
