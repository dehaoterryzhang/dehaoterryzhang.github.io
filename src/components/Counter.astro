---
// Counter.astro - Client-side view counter component using hits.sh
---

<span id="view-counter" class="font-semibold">...</span>

<script>
  // This script runs on the client side in the browser
  async function updateViewCount() {
    const counterEl = document.getElementById('view-counter');
    if (!counterEl) return;
    
    try {
      // Use hits.sh API - reliable and free
      // The URL path becomes the unique identifier for the counter
      const response = await fetch('https://hits.sh/dehaoterryzhang.github.io.json');
      
      if (!response.ok) {
        throw new Error('hits.sh failed');
      }
      
      const data = await response.json();
      
      if (data && data.count !== undefined) {
        counterEl.textContent = data.count.toLocaleString();
      } else {
        throw new Error('No count returned');
      }
    } catch (error) {
      console.log('Counter error:', error);
      // Fallback: show dash
      counterEl.textContent = '—';
    }
  }
  
  // Run when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', updateViewCount);
  } else {
    updateViewCount();
  }
</script>
